# ticketing-template — per-repository configuration. THIS FILE is the whole seam:
# everything else in scripts/ is project-agnostic. Every key has a default
# (scripts/doc_kit.py) equal to the behaviour of the repository the kit was
# extracted from, so an empty file is a valid file.

# Where work items live (one file each; moved to <tickets_dir>/closed on close).
tickets_dir = docs/tickets

# The work-item types the shape checker accepts. An EPIC is the tracking parent;
# a STORY names its parent in the field below.
work_item_types = EPIC STORY TASK BUG SPIKE
epic_field = epic

# Prefixes this repository DECLARES for its work items (space-separated). The
# hook and checkers use the UNION of these and the prefixes its tickets already
# use, so a prefix is covered before its first item exists, and an id-shaped
# string with any other prefix (SHA-256, ADR-007, RFC-6143) is prose, never a
# citation.
prefixes = MONITORING

# Never a prefix (KIT-020): id-shaped words that occur in prose with dash-digits. A declared
# prefix makes `API-001` in a sentence a citation the hook must resolve. Extend if needed.
prefix_denylist = API ID IP SHA AES RSA RFC ISO ADR TLS SSL HTTP HTTPS UTC URL URI DNS TCP UDP SQL CVE PR MR ETA FYI

# Epics model (ticketing-template D4). Leave epics_scope BLANK and epics live here, in
# tickets_dir, like any other item. Set it to a scope name and they live in the
# sibling repository <scope>-epics, found by walking up from this repo; a story
# names its parent with `epic: <ID>` and the checker resolves it THERE, at
# origin/<default_branch> only (D5). epics_remote is what a machine without the
# sibling clones (`bash scripts/epics.sh ensure`).
epics_scope = stealth
epics_remote = https://github.com/ljr9600/stealth-epics.git
epics_marker = .epics-root

# The branch tickets are born on and the board reads.
default_branch = master

# Paths a ticket-only commit on the default branch may also touch (KIT-005): the
# decision log, TODO.md, and for an epics repo its membership list and README.
maintenance_paths = TODO.md docs/DECISIONS.md docs/decisions docs/DECISIONS_INDEX.md CLAUDE.md vocabulary

# Machine commits exempt from "every commit names a work item": extended regexes,
# pipe-separated, matched against the SUBJECT line. A LIST of specific subjects,
# never a pattern like `^chore:` — an open-ended pattern becomes the escape hatch
# within a month. This key is the repository's own list (reports, gate stamps …).
commit_exempt_regex = 
# The installer OWNS this one (D14): its install/upgrade commit. Do not edit.
kit_exempt_regex = ^chore\(ticketing-template\): (install|upgrade) v[0-9]+\.[0-9]+\.[0-9]+

# Documents whose work-item citations must resolve (globs), and the frozen or
# generated ones that are exempt — history may cite a world that has moved on.
citation_sources = docs/**/*.md README.md CLAUDE.md AGENTS.md ARCHITECTURE.md TODO.md
citation_exempt = docs/archive docs/reports docs/DECISIONS.md docs/DECISIONS_INDEX.md

# Where `wi.py new` finds ticket-<TYPE>.md to copy from.
templates_dir = docs/templates

# --- decisions (KIT-016): one FILE each in decisions_dir, `Dn-<slug>.md`, first line
# `## Dn — title (date)`. The index is GENERATED by pre-commit at docs/DECISIONS_INDEX.md
# (always — never docs/DECISIONS.md, which, if present, is a hand-written legacy log:
# frozen, never edited, numbering continues after it). Override below.
decisions_dir = docs/decisions
decisions_frozen =
decisions_index =
citation_prefix = D

# --- teaching-doc kit (optional; only if this repo renders {{Dnnn}} citations) --
teaching_docs = docs/subsystems/*.md
retired_prefixes = MONIT
