#!/usr/bin/env bash
# ticketing-template passthrough (KIT-031): the kit has no pre-auto-gc rule of its own. This hands
# the event to scripts/git-hooks/pre-auto-gc.local, then to the clone's own .git/hooks/pre-auto-gc — neither
# of which git would run otherwise, since core.hooksPath points at this directory.
exec "$(dirname "$0")/_chain.sh" "$(basename "$0")" "$@"
