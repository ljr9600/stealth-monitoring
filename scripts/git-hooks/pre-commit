#!/usr/bin/env bash
# ticketing-template pre-commit: the machine writes what a human would otherwise remember.
#
# Each block states its own condition (no global early exit — a hook that returns
# early for one reason silently skips every check below it; that happened).
#
#   1. Time stamps (GOV-005): created/started/closed are written by the MACHINE at
#      the moment each event is committed, and staged into this commit.
#   2. Whenever a ticket is staged, the ticket checkers run: shape, citations,
#      documentation impact, status invariants. Fast — seconds, never minutes; a
#      hook that takes minutes gets bypassed with --no-verify.
#
# Install:  bash scripts/install-git-hooks.sh
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1   # the checkers must not litter the repo (KIT-011)
repo="$(git rev-parse --show-toplevel)"
# A missing config means defaults (KIT-027): never let a failed sed kill the hook under set -e.
cfg() { [ -f "$repo/docs/doc-kit.config" ] || return 0; sed -nE "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*(.*)$/\1/p" "$repo/docs/doc-kit.config" 2>/dev/null | head -1 || true; }
TDIR="$(cfg tickets_dir)"; TDIR="${TDIR:-docs/tickets}"; TDIR="${TDIR%/}"
staged="$(git diff --cached --name-only)"
# D46: checker output belongs to this invocation, never a machine-wide scratch file.

# The decisions index is DERIVED from the decision files (KIT-016): regenerate and stage it
# every commit, so a hand edit never survives and an added decision is indexed at once.
if [ -f "$repo/scripts/decisions-index.py" ]; then
  idx="$(python3 "$repo/scripts/decisions-index.py")" || { echo "pre-commit: decisions-index.py failed" >&2; exit 1; }
  case "$idx" in docs/*) git add "$repo/$idx" 2>/dev/null || true ;; esac
fi

if [ -f "$repo/scripts/stamp-ticket-times.py" ]; then
  python3 "$repo/scripts/stamp-ticket-times.py" || { echo "pre-commit: stamp-ticket-times.py failed" >&2; exit 1; }
fi

# A decision recorded in this commit is copied into the ticket it belongs to, and a
# {{Dn}} in a staged ticket expands (KIT-017). Refuses a {{Dn}} that names nothing.
if [ -f "$repo/scripts/decisions-into-tickets.py" ]; then
  python3 "$repo/scripts/decisions-into-tickets.py" || { echo "pre-commit: REJECTED — decisions-into-tickets (see above)" >&2; exit 1; }
  staged="$(git diff --cached --name-only)"
fi

if grep -qE "^${TDIR}/.*\.md$" <<<"$staged"; then
  fail=0
  for chk in check-ticket-shape.py check-item-references.py check-doc-impact.py check-ticket-status.py; do
    [ -f "$repo/scripts/$chk" ] || continue
    if ! check_output="$(python3 "$repo/scripts/$chk" 2>&1)"; then
      echo "pre-commit: $chk FAILED:" >&2; printf '%s\n' "$check_output" | sed 's/^/    /' | tail -20 >&2; fail=1
    fi
  done
  [ "$fail" = 0 ] || { echo "pre-commit: work items REJECTED — fix the problems above." >&2; exit 1; }
  echo "pre-commit: tickets well-formed (shape, citations, doc impact, status)"
fi
# Areas and tags come from the word lists when the project keeps them (KIT-060): a staged
# ticket whose area/tags are new or changed, and a staged list file, are checked.
VDIR="$(cfg vocabulary_dir)"; VDIR="${VDIR:-vocabulary}"; VDIR="${VDIR%/}"
if [ -f "$repo/scripts/check-vocabulary.py" ] && grep -qE "^(${TDIR}/.*\.md|${VDIR}/[^/]*\.tsv)$" <<<"$staged"; then
  check_output="$(python3 "$repo/scripts/check-vocabulary.py" 2>&1)" \
    || { printf '%s\n' "$check_output" | sed 's/^/    /' >&2; echo "pre-commit: REJECTED — areas/tags must come from the word lists (python3 scripts/wi.py words)." >&2; exit 1; }
  grep -E "^word lists:" <<<"$check_output" || true
fi
# An epics repo checks its registry against the repos on every commit (KIT-018): a row's
# prefix equals what the repo declares, no prefix twice, every claimant has a row.
if [ -f "$repo/.epics-root" ] && [ -f "$repo/scripts/check-scope.py" ]; then
  check_output="$(python3 "$repo/scripts/check-scope.py" 2>&1)" || { printf '%s\n' "$check_output" | sed 's/^/    /' >&2; echo "pre-commit: REJECTED — the scope registry (repos.tsv) disagrees with the repos." >&2; exit 1; }
  tail -1 <<<"$check_output"
fi
# Then, in order (KIT-023, KIT-031): the repo's OWN scripts/git-hooks/pre-commit.local
# (generators, renderers, targeted tests — versioned, never touched by an upgrade), and
# the clone's own .git/hooks/pre-commit (machine-installed; git stopped reading it when
# core.hooksPath was set). Either exiting non-zero refuses the commit. The order matters:
# the stamps above are already in the ticket when a renderer downstream copies it.
exec "$(cd "$(dirname "$0")" && pwd)/_chain.sh" pre-commit
