#!/usr/bin/env bash
# ticketing-template passthrough (KIT-031): the kit has no post-merge rule of its own. This hands
# the event to scripts/git-hooks/post-merge.local, then to the clone's own .git/hooks/post-merge — neither
# of which git would run otherwise, since core.hooksPath points at this directory.
exec "$(dirname "$0")/_chain.sh" "$(basename "$0")" "$@"
